<UserControl x:Class="winapp.FavoriteAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid x:Name="RootGrid" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 타이틀 및 수정 모드 버튼 -->
        <TextBlock Text="즐겨찾기 앱" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
        <Button x:Name="BtnToggleDeleteMode" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                Width="36" Height="36" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand"
                ToolTip="수정 모드" Click="BtnToggleDeleteMode_Click" Content="✏" FontSize="15">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="#444444"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 즐겨찾기 앱 목록 리스트박스 -->
        <ListBox x:Name="FavoriteListBox" Grid.Row="1" 
                 Background="Transparent" 
                 BorderThickness="0" 
                 AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="FavoriteListBox_PreviewMouseLeftButtonDown" 
                 MouseMove="FavoriteListBox_MouseMove"
                 Drop="FavoriteListBox_Drop"
                 MouseLeftButtonUp="FavoriteListBox_MouseLeftButtonUp">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="120"/>
                    <Setter Property="Height" Value="120"/>
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- 1. 일반 앱 카드 (IsAddButton이 false일 때만 표시) -->
                        <Border Background="{Binding CardBackgroundColor}" CornerRadius="8" Width="120" Height="120"
                                Visibility="{Binding NormalCardVisibility}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding AppIcon}" Width="44" Height="44" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding AppName}" Foreground="White" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                </StackPanel>

                                <!-- 삭제 버튼 (라운드 정사각형 적용) -->
                                <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        Background="#D9534F" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Visibility="{Binding DeleteButtonVisibility}"
                                        Tag="{Binding}" Click="BtnDelete_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <TextBlock Text="✕" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DelBorder" Property="Background" Value="#C9302C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2. 앱 추가 카드 (+ 모양 포함, IsAddButton이 true이고 수정 모드일 때만 표시) -->
                        <Border Background="#2A2A2A" CornerRadius="8" Width="120" Height="120" Cursor="Hand"
                                BorderBrush="#555555" BorderThickness="1"
                                Visibility="{Binding AddButtonVisibility}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="+" Foreground="#AAAAAA" FontSize="28" FontWeight="Light" TextAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="앱 추가" Foreground="#AAAAAA" FontSize="11" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 마우스 따라오는 고스트 아이콘 캔버스 -->
        <Canvas x:Name="DragCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="GhostBorder" Width="120" Height="120" 
                    Background="#3A3A3A" 
                    BorderBrush="#646464" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Opacity="0.85"
                    Visibility="Collapsed">
                <StackPanel x:Name="GhostContentPanel" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>