<Page x:Class="winapp.DeviceListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:winapp"
      Title="DeviceListPage" Background="#181818">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Page.Resources>
    
    <Grid Margin="16">
        <Border Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="LstDevices" ItemsSource="{Binding DeviceList}" 
                         SelectionChanged="LstDevices_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Foreground="White">
                
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- 카드 크기 220x220 정사각형 -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="#252525"/>
                            <Setter Property="Margin" Value="8"/>
                            <Setter Property="Padding" Value="16"/>
                            <Setter Property="Width" Value="220"/>
                            <Setter Property="Height" Value="220"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}" 
                                                BorderBrush="#333333" BorderThickness="1" CornerRadius="10"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#323232"/>
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#555555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- 카드 내부 템플릿 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="188" Height="188">
                            
                                <!-- 1. 일반 디바이스 카드인 경우 -->
                                <Grid Visibility="{Binding IsAddButton, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 기기 이름, 연결 상태, 배터리 표시부 -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" 
                                                Foreground="White" TextAlignment="Center"
                                                TextWrapping="Wrap" MaxWidth="170" MaxHeight="80"/>
                                        
                                        <!-- Orientation을 Vertical로 변경하고 여백(Margin) 수정 -->
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" 
                                                    FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                                            
                                            <!-- ★ 배터리 잔량 표시 (HasBattery가 True일 때만 아래에 노출) -->
                                            <TextBlock Text="{Binding BatteryText}" Foreground="#AAAAAA" 
                                                    FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"
                                                    TextAlignment="Center"
                                                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 연결/해제 버튼 -->
                                    <Button Grid.Row="1" Content="{Binding ButtonText}" Click="BtnToggleConnect_Click"
                                            Height="36" Width="140" FontSize="13" Margin="0,0,0,8" Cursor="Hand"
                                            HorizontalAlignment="Center"
                                            Background="#333333" Foreground="White" BorderBrush="#444444" BorderThickness="1">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                                    CornerRadius="6">
                                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 2. '+ 장치 추가' 카드인 경우 -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand"
                                            Visibility="{Binding IsAddButton, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="+" FontSize="40" FontWeight="Light" Foreground="#AAAAAA" 
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="장치 추가" FontSize="14" Foreground="#AAAAAA" 
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>