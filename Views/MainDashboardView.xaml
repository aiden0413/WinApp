<UserControl x:Class="winapp.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:winapp"
             Background="#181818">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="278"/>    <!-- 0. 상단 블루투스 기기 리스트 영역 -->
            <RowDefinition Height="*"/>      <!-- 1. 하단 즐겨찾기 앱 영역 (나머지 공간 전부 차지) -->
            <RowDefinition Height="Auto"/>    <!-- 2. 맨 아래 하단 제어 바 영역 (버튼이 들어갈 독립 공간) -->
        </Grid.RowDefinitions>

        <!-- 1. 블루투스 리스트 컴포넌트 -->
        <local:DeviceListView x:Name="MyDeviceListView" Grid.Row="0" Margin="0,0,0,12" DeviceSelected="MyDeviceListView_DeviceSelected"/>

        <!-- 2. 즐겨찾기 앱 컴포넌트 -->
        <local:FavoriteAppsView Grid.Row="1" Margin="0,0,0,12"/>

        <!-- 3. 맨 아래에 딱 붙는 하단 제어 바 컴포넌트 -->
        <local:BottomControlBarView Grid.Row="2"/>
    </Grid>
</UserControl>