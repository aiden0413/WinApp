<Window x:Class="winapp.AddChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="추가 방식 선택" Height="180" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="추가할 항목의 종류를 선택해주세요." Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="앱 추가" Width="100" Height="36" Margin="0,0,10,0"
                    Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand" Click="AppBtn_Click"/>
            <Button Content="사이트 추가" Width="100" Height="36"
                    Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="SiteBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>