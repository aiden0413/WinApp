<Window x:Class="winapp.AddSiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="사이트 추가" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF2D2D30" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="추가할 웹사이트 주소(URL)를 입력하세요:" FontSize="13" Margin="0,0,0,10"/>
        
        <TextBox x:Name="TxtUrl" Grid.Row="1" Height="30" VerticalContentAlignment="Center" 
                 Background="#FF333337" Foreground="White" BorderBrush="#FF515155" Padding="5,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="확인" Width="70" Height="28" Margin="0,0,10,0" Click="BtnConfirm_Click"
                    Background="#FF007ACC" Foreground="White" BorderBrush="{x:Null}"/>
            <Button Content="취소" Width="70" Height="28" Click="BtnCancel_Click"
                    Background="#FF3F3F46" Foreground="White" BorderBrush="{x:Null}"/>
        </StackPanel>
    </Grid>
</Window>