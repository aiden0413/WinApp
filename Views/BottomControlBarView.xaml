<UserControl x:Class="winapp.BottomControlBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- 가로 스크롤 영역 (스크롤바는 숨기고 마우스 드래그나 휠로 이동 가능하게 처리) -->
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
        <StackPanel Orientation="Horizontal">
            
            <!-- 1번 버튼: 시스템 볼륨 믹서 -->
            <Button x:Name="BtnOpenVolumeMixer" Click="BtnOpenVolumeMixer_Click"
                    Width="84" Height="84" Margin="0,0,8,0" Cursor="Hand"
                    Background="#222222" Foreground="White" BorderBrush="#333333" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎛️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="볼륨 믹서" FontSize="11" Foreground="#DDDDDD" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323232"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 2번 버튼: 블루투스 및 장치 설정 (기존 버튼과 동일한 스타일 적용) -->
            <Button Click="OpenBluetoothSettings_Click" 
                    Width="84" Height="84" Margin="0,0,8,0" Cursor="Hand"
                    Background="#222222" Foreground="White" BorderBrush="#333333" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🛜" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="블루투스" FontSize="11" Foreground="#DDDDDD" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#323232"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 나중에 추가할 다른 정사각형 버튼들은 여기에 계속 이어서 붙이면 됩니다 -->

        </StackPanel>
    </ScrollViewer>
</UserControl>