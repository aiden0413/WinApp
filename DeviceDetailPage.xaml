<Page x:Class="winapp.DeviceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DeviceDetailPage" Background="#202020" Foreground="White">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="기기 상세 정보" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="기기 이름:" Foreground="#888888" FontSize="12"/>
            <TextBlock x:Name="TxtName" Text="이름" FontSize="15" Margin="0,0,0,15"/>

            <TextBlock Text="기기 ID (MAC/Hardware ID):" Foreground="#888888" FontSize="12"/>
            <TextBlock x:Name="TxtId" Text="ID" FontSize="13" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <TextBlock Text="현재 연결 상태:" Foreground="#888888" FontSize="12"/>
            <TextBlock x:Name="TxtStatus" Text="상태" FontSize="15"/>
        </StackPanel>
    </Grid>
</Page>