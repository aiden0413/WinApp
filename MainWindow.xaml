<Window x:Class="winapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="블루투스 기기 관리 앱" Height="900" Width="800"
        Background="#181818" Foreground="White" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        
        <!-- 1. 드롭다운 상단 버튼 공통 스타일 -->
        <Style x:Key="DropdownMenuStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" 
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D2D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. MenuItem 스타일 (왼쪽 아이콘/체크 여백 공간을 완벽히 차단하는 Grid 구조) -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" 
                                BorderThickness="0" CornerRadius="4" Padding="14,10">
                            <!-- WPF 기본 체크/아이콘 영역 공간을 아예 없애버리는 그리드 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="1" x:Name="contentPresenter" 
                                                  Content="{TemplateBinding Header}" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#353535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. ContextMenu(드롭다운 박스 팝업) 자체의 테두리 및 여백 정리 스타일 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [상단 헤더 바] -->
        <Border Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1" Padding="8,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                
                <!-- 1. 뒤로 가기 화살표 버튼 -->
                <Button x:Name="BtnBack" Click="BtnBack_Click" 
                        Width="32" Height="30" Margin="0,0,8,0" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" 
                        ToolTip="뒤로 가기" Visibility="Hidden"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Path Data="M 10,2 L 2,10 L 10,18 M 3,10 L 18,10" 
                        Stroke="#DDDDDD" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="12" Height="12" Stretch="Uniform" 
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 2. 앞으로 가기 화살표 버튼 -->
                <Button x:Name="BtnForward" Click="BtnForward_Click" 
                        Width="32" Height="30" Margin="0,0,8,0" 
                        Background="Transparent" BorderThickness="0" Cursor="Hand" 
                        ToolTip="앞으로 가기" Visibility="Hidden"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                    <Path x:Name="ForwardIcon" Data="M 2,10 L 17,10 M 10,2 L 18,10 L 10,18" 
                        Stroke="#666666" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="12" Height="12" Stretch="Uniform" 
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2D2D2D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 3. 설정 메뉴 -->
                <Button Content="설정" Click="BtnSettingsMenu_Click" Style="{StaticResource DropdownMenuStyle}">
                    <Button.ContextMenu>
                        <ContextMenu Background="#252525" Foreground="White" BorderBrush="#3D3D3D">
                            <MenuItem Header="앱 환경 설정" Click="MenuSettingsAction_Click"/>
                            <MenuItem Header="블루투스 장치 초기화" Click="MenuResetAction_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- 4. 도움말 메뉴 -->
                <Button Content="도움말" Click="BtnHelpMenu_Click" Style="{StaticResource DropdownMenuStyle}">
                    <Button.ContextMenu>
                        <ContextMenu Background="#252525" Foreground="White" BorderBrush="#3D3D3D">
                            <MenuItem Header="사용 가이드" Click="MenuUserGuide_Click"/>
                            <MenuItem Header="버전 정보" Click="MenuVersion_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

            </StackPanel>
        </Border>

        <!-- 본문 프레임 영역 -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>