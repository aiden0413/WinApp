<UserControl x:Class="winapp.FavoriteAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:winapp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <local:InverseBoolToVisibilityConverter x:Key="BoolToVisConverterInverse"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 탭 관리 영역 -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="15,0,15,0">
            <!-- 동적 탭 목록 표시 (가로 스크롤) -->
            <ScrollViewer DockPanel.Dock="Left" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,6,0">
                                
                                <!-- 1. 일반 탭 (IsAddTabButton이 False일 때) -->
                                <Button Width="110" Height="34" Cursor="Hand"
                                        Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        x:Name="NormalTabBtn">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <!-- x:Name="TabBorder"를 가진 Border를 먼저 선언합니다 -->
                                                <Border x:Name="TabBorder" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                                                    <Grid Margin="10,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 평소에 보이는 탭 이름 -->
                                                        <TextBlock x:Name="NameTextBlock" Grid.Column="0" Text="{Binding TabName}" 
                                                                Visibility="{Binding TextBlockVisibility}"
                                                                Foreground="White" FontSize="13" FontWeight="SemiBold" 
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                        <!-- 수정 모드일 때 나타나는 탭 이름 수정용 TextBox -->
                                                        <TextBox x:Name="NameTextBox" Grid.Column="0" Text="{Binding TabName, UpdateSourceTrigger=PropertyChanged}" 
                                                                Visibility="{Binding TextBoxVisibility}"
                                                                Background="Transparent" Foreground="White" BorderBrush="#555555" BorderThickness="0,0,0,1"
                                                                FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                                        <!-- ✕ 삭제 버튼 -->
                                                        <Button Grid.Column="1" Width="18" Height="18" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                Background="#D9534F" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                                Visibility="{Binding DeleteButtonVisibility}"
                                                                Command="{Binding DataContext.DeleteTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                        <TextBlock Text="✕" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            
                                            <ControlTemplate.Triggers>
                                                <!-- 선택된 탭일 때 배경색을 강조 -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#3D3D3D"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#666666"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 2. [+ 탭 추가] 버튼 (IsAddTabButton이 True일 때) -->
                                <Button x:Name="AddTabBtnCard" Width="110" Height="34" Cursor="Hand"
                                        Command="{Binding DataContext.AddTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#1F1F1F" BorderBrush="#444444" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="+" FontSize="15" FontWeight="Medium" Foreground="#AAAAAA" Margin="0,-1,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="탭 추가" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </Grid>

                            <DataTemplate.Triggers>
                                <!-- IsAddTabButton이 True인 경우 처리 -->
                                <DataTrigger Binding="{Binding IsAddTabButton}" Value="True">
                                    <Setter TargetName="NormalTabBtn" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="AddTabBtnCard" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAddTabButton}" Value="False">
                                    <Setter TargetName="NormalTabBtn" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="AddTabBtnCard" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 우측 상단 수정모드(✏) 버튼 -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnToggleDeleteMode" 
                        Width="36" Height="36" Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand"
                        ToolTip="수정 모드" Click="BtnToggleDeleteMode_Click" Content="✏" FontSize="15">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#444444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- 즐겨찾기 목록 리스트박스 -->
        <ListBox x:Name="FavoriteListBox" Grid.Row="1" 
                 Background="Transparent" 
                 BorderThickness="0" 
                 AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="FavoriteListBox_PreviewMouseLeftButtonDown" 
                 MouseMove="FavoriteListBox_MouseMove"
                 Drop="FavoriteListBox_Drop"
                 MouseLeftButtonUp="FavoriteListBox_MouseLeftButtonUp">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="120"/>
                    <Setter Property="Height" Value="120"/>
                    <Setter Property="Margin" Value="8"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- 1. 일반 아이템 카드 -->
                        <Border Background="{Binding CardBackgroundColor}" CornerRadius="8" Width="120" Height="120"
                                Visibility="{Binding NormalCardVisibility}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Source="{Binding AppIcon}" Width="44" Height="44" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding AppName}" Foreground="White" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                                </StackPanel>

                                <!-- 삭제 버튼 -->
                                <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        Background="#D9534F" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Visibility="{Binding DeleteButtonVisibility}"
                                        Tag="{Binding}" Click="BtnDelete_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <TextBlock Text="✕" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DelBorder" Property="Background" Value="#C9302C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2. 추가 카드 (+ 추가 문구) -->
                        <Border Background="#2A2A2A" CornerRadius="8" Width="120" Height="120" Cursor="Hand"
                                BorderBrush="#555555" BorderThickness="1"
                                Visibility="{Binding AddButtonVisibility}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="+" Foreground="#AAAAAA" FontSize="28" FontWeight="Light" TextAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding AppName}" Foreground="#AAAAAA" FontSize="11" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 고스트 아이콘 캔버스 -->
        <Canvas x:Name="DragCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="GhostBorder" Width="120" Height="120" 
                    Background="#3A3A3A" 
                    BorderBrush="#646464" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Opacity="0.85"
                    Visibility="Collapsed">
                <StackPanel x:Name="GhostContentPanel" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>